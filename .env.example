NODE_ENV=development
PORT=3001
NATS_URL=nats://127.0.0.1:4222
NATS_A_CREDENTIALS_FILE=secrets/nats/gateway.creds
NATS_B_CREDENTIALS_FILE=secrets/nats/worker.creds

# Existing clinical Supabase project. Use the browser-safe publishable key only.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Restricted messaging_b_runtime role; URL-encode reserved password characters.
DATABASE_URL=postgresql://messaging_b_runtime.PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:5432/postgres
DATABASE_CA_CERT_PATH=secrets/db-ca.pem

# Run npm run keys:generate and put its output in .env (never commit private keys).
A_PRIVATE_KEY=
A_PUBLIC_KEY=
B_PRIVATE_KEY=
B_PUBLIC_KEY=
